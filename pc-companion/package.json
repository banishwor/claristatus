{
  "name": "claristatus-companion",
  "version": "1.0.0",
  "description": "ClariStatus Desktop Companion for 1080p Full HD WhatsApp Statuses",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "cli": "node send-hd.js",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.claristatus.companion",
    "productName": "ClariStatus Companion",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "server.js",
      "discovery.js",
      "preload.cjs",
      "ui/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/auth_info/**/*",
      "!**/*.log"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.19",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.8.1"
  }
}
